{
  "name": "Folio web development",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.13-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:2": {
      "version": "22"
    }
  },
  "postCreateCommand": "python -m pip install -r 02_Приложение/requirements.txt",
  "postStartCommand": "bash -lc 'nohup python -m http.server 8765 --bind 0.0.0.0 --directory \"02_Приложение/web\" >/tmp/folio-web.log 2>&1 &'",
  "forwardPorts": [8765],
  "portsAttributes": {
    "8765": {
      "label": "Folio web preview",
      "onAutoForward": "openBrowser"
    }
  }
}
